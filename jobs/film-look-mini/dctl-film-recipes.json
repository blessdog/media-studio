  "rich": {
   "why": "Negative gamma 0.6 (long latitude), print gamma 2.8 with D max 3.2 so blacks sit near code 13, a slight fade, and whites roll off near 203. Chosen offline for mid contrast about 1.15 for Ryan's 'richness, a deepness, a little bit of the fade'.",
   "stages": [
    {
     "dctl": "Clamp",
     "role": "clamp 0+",
     "params": {
      "Min Clamp": 0.0,
      "Clamp Min": 1,
      "Clamp Max": 0
     }
    },
    {
     "dctl": "Film Curve",
     "role": "negative",
     "params": {
      "Red Gamma": 0.6,
      "Red D_MIN": 0.01,
      "Red D_MAX": 2.6,
      "Red Offset": 0.0,
      "Green Gamma": 0.6,
      "Green D_MIN": 0.01,
      "Green D_MAX": 2.6,
      "Green Offset": 0.0,
      "Blue Gamma": 0.6,
      "Blue D_MIN": 0.01,
      "Blue D_MAX": 2.6,
      "Blue Offset": 0.0,
      "Mid Gray": 0.18,
      "Exposure Gain": 1.0,
      "Curve Type": 0
     }
    },
