  "rich-halation-grain": {
   "why": "rich-halation with Film Grain as the negative, which outputs the negative's transmittance itself (README: one instance per stock), so it replaces the negative Film Curve. A second Clamp 0+ follows Halation: without it, saturated teal went negative after the red-shift matrix and the negative Film Curve logged it into speckles (872 speckle pixels on IMG_0006's bowl vs 0 without halation, 2026-09-12).",
   "stages": [
    {
     "dctl": "Clamp",
     "role": "clamp 0+",
     "params": {
      "Min Clamp": 0.0,
      "Clamp Min": 1,
      "Clamp Max": 0
     }
    },
    {
     "dctl": "Halation",
     "role": "halation",
     "params": {
      "Reflection exposure lost": -5.0,
      "Red Shift Correction": 2
     }
    },
    {
     "dctl": "Clamp",
     "role": "clamp 0+ after halation",
     "params": {
      "Min Clamp": 0.0,
      "Clamp Min": 1,
      "Clamp Max": 0
     }
    },
    {
     "dctl": "Film Grain",
     "role": "negative grain",
     "params": {
      "D Max": 2.6,
      "D Min": 0.01,
      "Grains Per Pixel": 100,
      "Num Layers of Grains": 5,
      "Activation Threshold": 0.18,
      "Photon Gain": 0.5,
      "Noise Mode": 1
     }
    },
    {
     "dctl": "Multiplication Function",
     "role": "printer lights",
     "params": {
      "Global Gain": "solve"
     }
    },
    {
