				Red2 = Input { Value = 0.05, },
				Green2 = Input { Value = 0.08, },
				Blue2 = Input { Value = 0.18, },
				Alpha2 = Input { Value = 0.92, }
			},
			ViewInfo = OperatorInfo { Pos = { 220, 49.5 } },
		}
